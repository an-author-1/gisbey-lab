# Names only — no real values. Copy to .env and fill in locally; .env is gitignored.

# Required for live Jev calls. The typesafe-sdk client reads this name directly.
TYPESAFE_API_KEY=

# Optional. Defaults to jev-latest if unset.
TYPESAFE_MODEL=jev-latest

# Legacy names from an earlier draft of this file — still honored as a fallback by
# gibsey_lab.config, but TYPESAFE_API_KEY / TYPESAFE_MODEL above are canonical now.
# JEV_API_KEY=
# JEV_MODEL_ID=
